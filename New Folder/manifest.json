
{
  "manifest_version": 3,
  "name": "Custom Font Changer",
  "version": "1.0",
  "description": "Change the font of any website.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
 /* "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }*/
    "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["popup.js"],
      "run_at": "document_start"
    }
    ]
}
